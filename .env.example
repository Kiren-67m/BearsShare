# Bears Share — environment variables template
# Copy to `.env` for local dev, or set these in the Render dashboard for production.
# Never commit the real .env (it is gitignored).

# ── SMTP (required) ─────────────────────────────────────────────
SMTP_USER=your.email@gmail.com
SMTP_PASSWORD=your-app-password        # Gmail App Password, enter WITHOUT spaces
SMTP_SERVER=smtp.gmail.com             # optional; MSU SMTP host in production
SMTP_PORT=465                          # optional; 465=SSL (default), 587=STARTTLS
FROM_EMAIL=                            # optional; falls back to SMTP_USER if blank

# ── App (required in production) ────────────────────────────────
SECRET_KEY=change-me-to-a-random-string   # signs sessions + unsubscribe tokens
                                          # ⚠️ changing it invalidates old unsubscribe links
BASE_URL=https://bearsshare.onrender.com  # public URL, used to build unsubscribe links
DATABASE_URL=                             # Render Postgres URL; blank = local SQLite (resets on deploy)

# ── Optional ────────────────────────────────────────────────────
ACCESS_CODE=                              # if set, staff must enter it to send / import CSV
PHYSICAL_ADDRESS=                         # CAN-SPAM footer address; sensible default if blank
